 #include <SITL/SIM_JSBSim.h>
 #include <AP_HAL/utility/Socket_native.h>
 
@@ -253,6 +254,20 @@
     // replace outputs from multicast
     multicast_servo_update(input);
 
+#if AP_BATTERY_ENABLED
+    // Enforce battery power after every actuator override, without stopping physics.
+    const AP_BattMonitor *battery = AP_BattMonitor::get_singleton();
+    float consumed_mah;
+    if (battery != nullptr && battery->consumed_mah(consumed_mah)) {
+        _battery_power.update(battery->healthy(AP_BATT_PRIMARY_INSTANCE),
+                              battery->pack_capacity_mah(), consumed_mah);
+    }
+    if (_battery_power.apply(input.servos, sitl_model->get_frame())) {
+        _sitl->throttle = 0.0f;
+        update_voltage_current(input, 0.0f);
+    }
+#endif
+
     // update the model
     sitl_model->update_home();
     sitl_model->update_model(input);
